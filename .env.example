# Copy to .env for local development. On Vercel, add the same names under
# Project Settings > Environment Variables. Never commit the real .env file.

# Required. MongoDB connection string (Atlas: Connect > Drivers).
MONGODB_URI=

# Optional. Database name, used when the connection string has none. Default: kainvara
MONGODB_DB=

# Recommended in production. Signs the session cookie. Use a long random value,
# for example the output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# When empty, a stable secret is derived from the connection string.
JWT_SECRET=

# Recommended in production. Vercel sends it with every cron request, so only
# Vercel can call /api/cron/keepalive. When empty the endpoint is open, it only
# records a timestamp.
CRON_SECRET=

# Optional. Creates (or updates) the store admin when the database is seeded
# with "npm run db:seed". Without these there is no admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Final phase, not used yet.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
